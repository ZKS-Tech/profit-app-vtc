{
  "expo": {
    "name": "VTC Profit AI",
    "slug": "vtc-profit-ai",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zkstech.vtcprofitai",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A111F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VTC Profit AI utilise votre position, uniquement quand l’app est ouverte, pour estimer le temps de trajet vers chaque quartier. Elle n’est ni enregistrée ni envoyée.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "vtcprofitai",
    "backgroundColor": "#0A111F",
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "11aee2b9-c8d5-4a21-8660-d285294e93ef"
      }
    },
    "owner": "evanlgz"
  }
}
